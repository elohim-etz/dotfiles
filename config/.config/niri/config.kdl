// INPUT
input {
    keyboard {
        xkb {
        }
        numlock
        repeat-delay 600
        repeat-rate 25
    }
    
    touchpad {
        tap
        natural-scroll
        dwt
        accel-speed 0.0
    }
    
    mouse {
        accel-speed 0.0
    }
    
    focus-follows-mouse max-scroll-amount="0%"
}

// Laptop display
output "eDP-1" {
    mode "1920x1080@59.997"
    scale 1.0
    transform "normal"
}

// Desktop monitor
output "HDMI-A-1" {
    mode "1920x1080@60.000"
    scale 1.0
    position x=1920 y=0
}

// LAYOUT
layout {
    gaps 2
    center-focused-column "never"
    
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    
    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    
    focus-ring {
        off
    }
    
    border {
        on
        width 2
        active-gradient from="#ca9ee6ff" to="#f2d5cfff" angle=45
        inactive-gradient from="#b4befecc" to="#6c7086cc" angle=45
        urgent-color "#9b0000"
    }
    
    default-column-width { proportion 1.0; }
    
    struts {
        left 0
        right 0
        top 0
        bottom 0
    }

    background-color "transparent"

}

// LAYER RULES
layer-rule {
    match namespace="^swww-daemon$"
    place-within-backdrop true
}

layer-rule {
    match namespace="^notifications$"
    block-out-from "screencast"
}

overview {
    zoom 0.25
}

spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "swww-daemon"

// WINDOW RULES
prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width { proportion 0.5; }
}

window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screen-capture"
}

window-rule {
    match app-id="kitty"
    open-maximized false
    default-column-width { proportion 0.5; }
}

window-rule {
    geometry-corner-radius 3
    clip-to-geometry true
}

window-rule {
    match app-id="brave-browser"
    match app-id="spotify"
    match app-id="zen"
    match app-id="ayugram"
    match app-id="code-oss"
    open-maximized true
}

window-rule {
    match app-id="^blueman-manager$"
    match app-id="^.blueman-manager-wrapped$"
    open-floating true
    default-column-width { fixed 600; }
    default-window-height { fixed 400; }
    max-width 800
    max-height 700
}

window-rule {
    match app-id="^xdg-desktop-portal-gtk$"
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id="^pavucontrol$"
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    open-floating true
    default-column-width { fixed 600; }
    default-window-height { fixed 400; }
    max-width 900
    max-height 800
}

window-rule {
    match app-id="^nemo$"
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 600; }
}

window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
    default-floating-position x=32 y=32 relative-to="bottom-right"
}

window-rule {
    match app-id=r#"^org\.gnome\.Calculator$"#
    match app-id="^gnome-calculator$"
    match app-id="^kcalc$"
    open-floating true
    default-column-width { fixed 400; }
    default-window-height { fixed 500; }
}

window-rule {
    match app-id="^btop$"
    match app-id="^htop$"
    default-column-width { proportion 0.75; }
}

//  ENVIRONMENT VARIABLES
environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    
    // Backend preferences
    GDK_BACKEND "wayland,x11"
    QT_QPA_PLATFORM "wayland;xcb"
    SDL_VIDEODRIVER "wayland"
    CLUTTER_BACKEND "wayland"
    
    MOZ_ENABLE_WAYLAND "1"
    
    QT_QPA_PLATFORMTHEME "qt5ct"
    
    ELECTRON_OZONE_PLATFORM_HINT "wayland"
}

// CURSOR THEME
cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
}

// KEY BINDINGS
binds {
    Mod+T hotkey-overlay-title="Terminal: kitty" { spawn "kitty"; }
    Mod+E hotkey-overlay-title="File Manager: nemo" { spawn "nemo"; }
    Mod+A hotkey-overlay-title="App Launcher: wofi" { spawn-sh "pkill wofi || wofi --show drun"; }
    Mod+W hotkey-overlay-title="Wallpaper Picker" { spawn-sh "$HOME/.local/bin/wallpaperselect.sh"; }
    
    // -------------------- System --------------------
    Mod+Alt+L hotkey-overlay-title="Lock Screen: hyprlock" { spawn "hyprlock"; }
    Ctrl+Alt+Delete hotkey-overlay-title="Power Menu: wlogout" { spawn "wlogout" "--buttons-per-row" "2"; }
    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
    
    // Toggle keyboard shortcuts (useful when gaming)
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    
    // -------------------- Audio Controls --------------------
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    
    // Fallback keys for laptops without media keys
    F2 allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"; }
    F3 allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0"; }
    F4 allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    Alt+F4 allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    
    // -------------------- Media Controls --------------------
    XF86AudioPlay allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "playerctl next"; }
    
    // Fallback keys
    F1 allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    F5 allow-when-locked=true { spawn-sh "playerctl previous"; }
    F6 allow-when-locked=true { spawn-sh "playerctl next"; }
    
    // -------------------- Brightness Controls --------------------
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }
    
    // Fallback keys
    F11 allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }
    F12 allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    
    // -------------------- Screenshots --------------------
    Mod+P { spawn-sh "grim -g \"$(slurp)\" - | satty -f -"; }
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    
    // -------------------- Window Management --------------------
    Mod+Return repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }
    
    // Focus
    Mod+Left  { focus-column-left; }
//  Mod+Down  { focus-window-down; }
//  Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+Down  { focus-workspace-down; }
    Mod+Up    { focus-workspace-up; }
    
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    
    // Move windows
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+L { move-column-right; }
    
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }
    
    // -------------------- Monitor Management --------------------
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    
    Mod+Shift+H { focus-monitor-left; }
    Mod+Shift+J { focus-monitor-down; }
    Mod+Shift+K { focus-monitor-up; }
    Mod+Shift+L { focus-monitor-right; }
    
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    
    Mod+Shift+Ctrl+H { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L { move-column-to-monitor-right; }
    
    // -------------------- Workspace Management --------------------
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+U         { focus-workspace-down; }
    Mod+I         { focus-workspace-up; }
    
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }
    
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }
    
    // Mouse wheel workspace switching
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    
    // Horizontal scrolling for columns
    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }
    
    // Alternative horizontal scrolling (shift+wheel)
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }
    
    // -------------------- Workspace Numbers --------------------
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    
    // -------------------- Column Operations --------------------
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma        { consume-window-into-column; }
    Mod+Period       { expel-window-from-column; }
    
    // -------------------- Window Sizing --------------------
    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R  { reset-window-height; }
    
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    
    // -------------------- Window States --------------------
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Ctrl+F  { expand-column-to-available-width; }
    
    // -------------------- Centering --------------------
    Mod+C      { center-column; }
    Mod+Ctrl+C { center-visible-columns; }
    
    // -------------------- Floating/Tiling --------------------
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
}
