{
    "label": "suspend",
    "action": "hyprlock & disown && systemctl suspend",
    "text": "Suspend",
    "keybind": "u"
}

{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "Shutdown",
    "keybind": "s"
}

{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "Reboot",
    "keybind": "r"
}

{
    "label": "logout",
    "action": "systemctl --user exit",
    "text": "Logout",
    "keybind": "e"
}
